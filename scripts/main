#!/bin/zsh
set -eu

domain="large.fyi"
production_bucket="r2-for-large-fyi:large-fyi-public"

script_path=$(realpath $0)
scripts_dir_path=$(dirname $script_path)
project_dir_path=$(dirname $scripts_dir_path)
site_path="$project_dir_path/_site"
posts_path="$project_dir_path/_posts"
post_assets_path="$project_dir_path/assets/posts"

source "$scripts_dir_path/activate_env"

ensure_bundler () {
    local lockfile="$project_dir_path/Gemfile.lock"
    [[ -f $lockfile ]] || return 0
    local pinned=$(awk '/^BUNDLED WITH$/ {getline; gsub(/^ +| +$/, ""); print; exit}' "$lockfile")
    [[ -n $pinned ]] || return 0
    [[ -f "$(gem environment gemdir)/gems/bundler-$pinned/exe/bundle" ]] && return 0
    echo "Installing bundler $pinned (present only as a default gem; the shim needs a real install)..."
    gem install bundler -v "$pinned" --no-document
}

dev () {
    ensure_bundler
    bundle exec jekyll serve --incremental
}

test () {
    ensure_bundler
    # check_names --print-on-fail
    # check_for_archived_pages
    JEKYLL_ENV="production" bundle exec jekyll build --incremental
    proof_html
    
    rclone sync \
        --checksum \
        --progress \
        --fast-list \
        --track-renames \
        --dry-run \
        $site_path \
        $production_bucket
}

push () {
    git pull
    git push
    ensure_bundler
    # check_names --die-on-fail
    # archive_new_links
    JEKYLL_ENV="production" bundle exec jekyll build
    proof_html
    
    rclone sync \
        --checksum \
        --progress \
        --fast-list \
        --track-renames \
        $site_path \
        $production_bucket
    
    # set the caching headers on all files that need it with https://s3tools.org/s3cmd (maybe)
    # purge the cache of updated files
}

init_env () {
    ensure_bundler
    bundle config set path "$project_dir_path/vendor.noindex"
    bundle config set bin "$project_dir_path/bin"
    bundle install
}

give_names () {
    $dir_path/scripts/give_names.rb
}

check_names () {
    $dir_path/scripts/check_names.rb $1
}

proof_html () {
    bundle exec htmlproofer $site_path \
        --checks Links,Images,Scripts,Favicon,OpenGraph \
        --swap-urls "^https\\://${domain//./\\.}:" \
        --ignore-urls '/^https:\/\/www\.(merriam-webster\.com|oed\.com)\//,/^https:\/\/www\.oed\.com$/' \
        --cache '{"timeframe": {"external": "2d"}}'
}

subcommand="${1}" 
case ${subcommand} in 
    dev)
        dev
        ;;
    test)
        test
        ;;
    push)
        push
        ;;
    init_env)
        init_env
        ;;
    *)
        echo "`basename ${0}`: usage: dev | test | push | init_env" 
        exit 1
        ;; 
esac
